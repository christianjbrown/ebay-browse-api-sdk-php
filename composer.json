{
    "name": "christianjbrown/ebay-find-service-api",
    "require": {
        "php": "^8.3",
        "christianjbrown/php-json-api-client-lib": "dev-main",
        "christianjbrown/php-user-friendly-exception-lib": "dev-main",
        "psr/http-client": "^1.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "ChristianBrown\\eBay\\FindServiceApi\\": "src/",
            "ChristianBrown\\eBay\\FindServiceApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "bin-dir": "bin"
    },
    "scripts": {
        "check-style": ["clear && ./bin/php-cs ./src ./tests"],
        "check-style-diff": ["clear && ./bin/php-cs-diff"],
        "fix-style": ["clear && ./bin/php-cs-fix ./src ./tests"],
        "fix-style-diff": ["clear && ./bin/php-cs-fix-diff"],
        "test": ["clear && XDEBUG_MODE=coverage ./bin/phpunit -d memory_limit=512M && open ./.phpunit.cache/code-coverage-html/index.html"]
    },
    "repositories": [
        {"type": "github", "url": "git@github.com:christianjbrown/php-code-quality-scripts.git"},
        {"type": "github", "url": "git@github.com:christianjbrown/php-json-api-client-lib.git"},
        {"type": "github", "url": "git@github.com:christianjbrown/php-user-friendly-exception-lib.git"}
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "christianjbrown/php-code-quality-scripts": "dev-main"
    }
}
